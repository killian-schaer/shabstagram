# Copiez ce fichier en ".env" et completez les valeurs. Le fichier ".env"
# ne doit jamais etre commite (il est deja dans .gitignore).

# --- Application ---
# APP_NAME : nom affiche partout dans l'application et dans les e-mails
# (titres de page, pied de mail, etc.). Modifiez uniquement cette valeur
# pour renommer l'application sans toucher au code.
APP_NAME="Shabstagram"
APP_ENV=local
APP_URL=https://fosc.intra.budin.ch
APP_LOCALE=fr
APP_TIMEZONE=Europe/Zurich

# --- Base de donnees ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=shabstagram
DB_USERNAME=shabstagram
DB_PASSWORD=

# --- Connexion professionnelle (Microsoft Entra ID) ---
# Une seule inscription d'application suffit : elle sert a la fois a la
# connexion des utilisateurs (delegue) et a l'envoi de mails / recherche
# d'annuaire (jeton applicatif). Permissions applicatives a consentir par un
# administrateur du tenant : Mail.Send, User.Read.All.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://fosc.intra.budin.ch/callback.php
ENTRA_LOGIN_SCOPES="openid profile email User.Read"

# --- Envoi des notifications (jeton applicatif Microsoft Graph) ---
GRAPH_SENDER_UPN=notifications@budin.ch
GRAPH_SENDER_NAME="Shabstagram"

# --- Destinataire des alertes de supervision du cron ---
ADMIN_ALERT_EMAIL=

# --- Coupe-circuit d'authentification (DANGEREUX) ---
# Si "true", l'authentification professionnelle est totalement contournee et
# une session d'administration factice est ouverte automatiquement, sans
# jamais creer d'utilisateur reel en base. Reserve au developpement local.
# Ne JAMAIS activer en production.
AUTH_KILLSWITCH=false

# --- Recherche dans les feuilles officielles ---
# Domaine de recherche par defaut, utilise pour l'insertion initiale dans la
# table "tenants" (schema.sql). Au-dela de cette valeur initiale, la liste
# des feuilles officielles interrogees est pilotee par la base de donnees.
FOSC_API_BASE_DOMAIN=www.fosc.ch
# Domaines de confiance autorises lorsque l'application suit un lien "ref"
# fourni par l'API (protection contre une redirection vers un hote non
# desire), separes par des virgules.
FOSC_ALLOWED_REF_HOSTS=amtsblattportal.ch,www.fosc.ch,fosc.ch
# Nombre de jours minimum couverts a chaque execution du cron de recherche.
CRON_LOOKBACK_DAYS=7

# --- Stockage des fichiers recuperes ---
STORAGE_PATH=/var/www/claude-apps/shabstagram/storage
LOG_PATH=/var/www/claude-apps/shabstagram/var/logs

# --- Supervision du cron (battements de coeur) ---
HEARTBEAT_PATH=/var/www/claude-apps/shabstagram/var/heartbeat
# Age maximal tolere (en heures) du dernier battement avant de considerer
# que le cron principal ne s'execute plus.
HEARTBEAT_MAX_AGE_HOURS=26
# Delai minimum (en heures) entre deux alertes identiques envoyees a
# ADMIN_ALERT_EMAIL, pour eviter le spam en cas de panne persistante.
ALERT_THROTTLE_HOURS=12

# --- Theme visuel ---
THEME_ACCENT_COLOR=#123475
